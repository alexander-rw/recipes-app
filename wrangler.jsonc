// Cloudflare Workers Builds deploys the static CRA build as an assets-only Worker
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes-app",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  },
  // Served only at recipes.alexander-rw.com; deploys create and keep its DNS record
  "routes": [{ "pattern": "recipes.alexander-rw.com", "custom_domain": true }],
  "workers_dev": false
}
